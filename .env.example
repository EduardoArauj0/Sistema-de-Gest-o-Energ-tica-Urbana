# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta do servidor HTTP Express
PORT=3000

# Caminhos dos bancos SQLite (normal e de teste)
DB_PATH=./backend/data/sge-urbano.sqlite
DB_TEST_PATH=./backend/data/sge-urbano.test.sqlite

# Segurança e Sessão (RNF06: 30 minutos de inatividade)
SESSION_SECRET=sge-urbano-dev-secret-change-me
SESSION_TIMEOUT_MINUTES=30

# Diretório de logs técnicos (RNF03)
LOG_DIR=./logs

# Parâmetros configuráveis de detecção de anomalias (RN06, RN07, RNF13)
ANOMALY_LIM_SUP=10
ANOMALY_LIM_INF=10
ANOMALY_TOL_ZERO=0.5
ANOMALY_FAIXA_MEDIA=20
ANOMALY_FAIXA_ALTA=50

# Fator multiplicador do cenário de pico aprovado em OD-03 (1.50 = +50%)
SIMULATION_PEAK_FACTOR=1.50
